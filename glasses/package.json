{
  "name": "@footnote/glasses",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "simulate": "evenhub-simulator http://localhost:5173",
    "pack": "npm run build && node scripts/pack.mjs",
    "pack:demo": "npm run build -- --mode demo && node scripts/pack.mjs --demo"
  },
  "dependencies": { "@evenrealities/even_hub_sdk": "0.0.16" },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.1.14",
    "@evenrealities/evenhub-simulator": "0.9.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
